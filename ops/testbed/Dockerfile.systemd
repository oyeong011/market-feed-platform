# systemd 가 실제로 도는 리눅스 테스트베드.
#
# 왜 필요한가: ops/systemd/*.service 를 "썼다"와 "돌려봤다"는 다르다.
# Restart 정책, TimeoutStopSec, ProtectSystem=strict, ReadWritePaths, LimitNOFILE 은
# 실제 systemd 아래에서만 검증된다. 개발은 macOS 에서 했으므로 이 컨테이너로 확인한다.
#
#   docker build -f ops/testbed/Dockerfile.systemd -t mdfeed-systemd-test .
#   docker run -d --name t --privileged --cgroupns=host \
#     -v /sys/fs/cgroup:/sys/fs/cgroup:rw mdfeed-systemd-test
#   docker exec t systemctl start mdfeed.target
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive container=docker

RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd systemd-sysv python3 python3-venv ca-certificates curl procps \
        iproute2 less \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# 컨테이너에서 불필요하거나 실패하는 유닛 정리 (systemd 부팅을 막는다)
RUN find /etc/systemd/system /lib/systemd/system \
      -path '*.wants/*' \
      \( -name '*getty*' -o -name '*udev*' -o -name '*mount*' \
         -o -name '*swap*' -o -name '*resolved*' -o -name '*networkd*' \) \
      -exec rm -f {} + || true

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
