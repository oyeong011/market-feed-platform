# ops/mdfeed.local.env — 개발 노트북용 실행 설정 (make up / make up-bg 가 읽는다)
#
# 왜 이 파일이 있나
# -----------------
# 2026-09-03: 재기동 한 번에 유니버스가 4,327 → 7 종목으로 줄었다. 한도 설정이
# **셸 환경변수에만** 있었기 때문이다. 다른 셸에서 make up-bg 를 하니 조용히
# 기본값으로 돌아갔고, 상태판에는 아무 표시가 없었다. 배포단은 systemd
# EnvironmentFile 로 이미 파일에서 읽고 있었는데 개발단만 셸에 기대고 있었다.
#
# 재현되지 않는 설정은 설정이 아니다. 쓸 거면 파일로 남긴다.
#
#   cp ops/mdfeed.local.env.example ops/mdfeed.local.env
#   make up-bg-shards
#
# 자격증명은 여기에 두지 않는다. ~/.mdfeed/kis.env (chmod 600) 에 둔다.

# ── 종목 유니버스 ─────────────────────────────────────────────────────────
# 한도 0 = 명시 목록(기본 7종목). >0 이면 마스터에서 앞의 N개.
# 실측 가용: 업비트 KRW 288 · 바이낸스 USDT 485
MDFEED_UPBIT_UNIVERSE_LIMIT=288
MDFEED_BINANCE_UNIVERSE_LIMIT=485

# KOSPI 만 두면 1,783종목이다. KOSDAQ 을 넣어야 3,554종목이 된다.
# 기본값이 KOSPI 하나라, 안 적으면 절반이 조용히 빠진다.
MDFEED_KRX_MARKETS=KOSPI,KOSDAQ
MDFEED_KRX_UNIVERSE_LIMIT=0

# ── 보존 ──────────────────────────────────────────────────────────────────
# 0 = 끄기. 켜기 전에 `python3 -m mdfeed.cli retention --days 1 3 7 14` 로
# 무엇이 지워질지 먼저 본다. 되돌릴 수 없는 결정이다.
MDFEED_RETENTION_DAYS=0
MDFEED_RETENTION_BUDGET_S=30
