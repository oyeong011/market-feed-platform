  {
   "id": 1,
   "title": "발행 처리량",
   "description": "모든 샤드의 초당 발행 프레임. 0 이면 수집이 멈춘 것이다(장 시간 확인 후 판단)",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "sum(rate(mdfeed_published_total[1m]))",
     "refId": "A"
    }
   ]
  },
  {
