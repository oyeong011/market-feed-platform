[Unit]
Description=MDFeed fetched-back restore drill
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mdfeed-maintenance
Group=mdfeed
WorkingDirectory=/opt/mdfeed
Environment=PYTHONPATH=/opt/mdfeed/src
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/mdfeed/mdfeed.env
ExecStart=/usr/bin/python3 ops/backup_restore_drill.py --backup-dir /var/lib/mdfeed/backups --receipt-dir /var/lib/mdfeed/backup/receipts --maintenance-dsn-env MDFEED_MAINTENANCE_DSN
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mdfeed-restore-drill
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mdfeed /var/log/mdfeed
ReadOnlyPaths=/etc/mdfeed
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
