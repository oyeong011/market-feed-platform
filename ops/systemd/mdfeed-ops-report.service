[Unit]
Description=MDFeed 일일 운영 기록
# 스택이 안 떠 있으면 리포트가 "응답 없음"을 기록한다. 그것도 정보라서 막지 않는다.
After=mdfeed.target

[Service]
Type=oneshot
User=mdfeed
WorkingDirectory=/opt/mdfeed
Environment=MDFEED_ENV_FILE=/etc/mdfeed/mdfeed.env
# %i 는 템플릿 유닛(@.service)에서만 치환된다. 여기서는 실행 시점에 날짜를 만든다.
ExecStart=/bin/sh -c 'D=$(date +%%F); exec /usr/bin/python3 scripts/ops_report.py \
  --json "docs/data/ops/$D.json" --out "docs/data/ops/$D.md"'
# 조회 실패로 종료코드가 1 이어도 타이머를 죽이지 않는다
SuccessExitStatus=0 1
