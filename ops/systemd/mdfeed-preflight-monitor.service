[Unit]
Description=MDFeed private preflight metrics monitor
After=network-online.target
Wants=network-online.target

# crash loop 방지. **[Unit] 에 있어야 한다** — systemd v230 부터 이 둘은 [Unit] 옵션이고,
# [Service] 에 두면 "Unknown key name ... ignoring" 으로 조용히 무시된다. 한동안 그 상태였다.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=mdfeed
Group=mdfeed
WorkingDirectory=/opt/mdfeed
Environment=PYTHONPATH=/opt/mdfeed/src
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/mdfeed/mdfeed.env
ExecStart=/usr/bin/python3 ops/preflight_monitor.py --config /etc/mdfeed/mdfeed.env --host 127.0.0.1 --port 9120
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mdfeed-preflight-monitor
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mdfeed /var/log/mdfeed
ReadOnlyPaths=/etc/mdfeed
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
