[Unit]
Description=MDFeed — 전략 시그널 엔진
Documentation=https://github.com/oyeong011/market-feed-platform
After=mdfeed-feedd.service
# feedd 가 UDS 버스 소켓을 만든 뒤에 소비자가 떠야 하므로 After= 로 순서를 준다.
#
# 단 Requires= 는 쓰지 않는다. Requires= 로 두면 feedd 가 재시작될 때 소비자까지
# 함께 재시작된다 — 실제 systemd 에서 feedd 를 SIGKILL 했더니 tcp-gateway 와
# writer 의 PID 도 같이 바뀌는 걸 확인했다.
#
# 버스 구독자에는 지수 백오프 자동 재접속이 들어 있다. 소비자가 feedd 재시작을
# 타고 넘으라고 만든 장치인데, Requires= 가 그걸 무력화한다. 소비자를 함께 내리면
# 그동안 쌓이던 배치 버퍼도 같이 날아간다.
#
# Wants= 는 "함께 켜지면 좋다"는 의사표시만 하고 재시작을 전파하지 않는다.
Wants=mdfeed-feedd.service
PartOf=mdfeed.target

[Service]
Type=simple
User=mdfeed
Group=mdfeed
WorkingDirectory=/opt/mdfeed
Environment=PYTHONPATH=/opt/mdfeed/src
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/mdfeed/mdfeed.env
ExecStart=/usr/bin/python3 -m mdfeed.services.strategy

# ── 재시작 정책 ───────────────────────────────────────────────────────────
# on-failure: 정상 종료(SIGTERM)에는 재시작하지 않는다. always 로 두면
# 수동 정지조차 되살아나 배포 중 혼란을 만든다.
Restart=on-failure
RestartSec=3
# 60초 안에 5번 넘게 죽으면 멈춘다. 설정 오류로 무한 재시작 루프를 도는 대신
# 실패 상태로 남겨 사람이 보게 한다.
StartLimitIntervalSec=60
StartLimitBurst=5

# ── 종료 ──────────────────────────────────────────────────────────────────
KillSignal=SIGTERM
# 버퍼 flush와 DB 커밋에 필요한 시간. 짧게 잡으면 배포마다 데이터가 샌다.
TimeoutStopSec=30
KillMode=mixed

# ── 로깅 ──────────────────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mdfeed-strategy

# ── 보안 강화 ─────────────────────────────────────────────────────────────
# 시세 수집기는 아웃바운드 TCP와 자기 데이터 디렉터리 외에 아무것도 필요 없다.
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mdfeed /var/log/mdfeed /run/mdfeed
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

# ── 리소스 한계 ───────────────────────────────────────────────────────────
# 구독자 수 × 소켓 + 업스트림 세션. 기본 1024는 배포단에서 금방 모자란다.
LimitNOFILE=65536
MemoryMax=1G


[Install]
WantedBy=multi-user.target
