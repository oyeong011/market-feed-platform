# /etc/mdfeed/mdfeed.env — systemd EnvironmentFile
# 자격증명이 들어가므로 chmod 640, chown root:mdfeed 로 둘 것.

MDFEED_ADAPTERS=upbit,binance

# 종목 유니버스 — 두 가지 방식
#  (1) 아래처럼 직접 나열한다. 소수 종목을 확실히 지정할 때.
MDFEED_UPBIT_SYMBOLS=KRW-BTC,KRW-ETH,KRW-XRP,KRW-SOL
MDFEED_BINANCE_SYMBOLS=btcusdt,ethusdt,solusdt
#  (2) 한도를 >0 으로 두면 마스터 파일에서 앞의 N종목을 쓴다.
#      python scripts/fetch_crypto_symbols.py 로 마스터를 만든 뒤 켠다.
#      실측 가용: 업비트 KRW 288 · 바이낸스 USDT 485
# MDFEED_UPBIT_UNIVERSE_LIMIT=288
# MDFEED_BINANCE_UNIVERSE_LIMIT=400
# MDFEED_CRYPTO_UNIVERSE=/opt/mdfeed/data/reference/crypto_symbols.csv
#
# 688종목 실측(개발 노트북): 초당 약 276건, 버스 드롭 0, 링 초과 0,
# 서비스당 RSS 28~41MB. 바이낸스는 50종목을 넘으면 URL 대신 SUBSCRIBE 로
# 나눠 구독한다(400종목이면 URL 이 6,023바이트라 요청줄 상한에 걸린다).

MDFEED_RUN_DIR=/run/mdfeed
MDFEED_BUS_PATH=/run/mdfeed/bus.sock
MDFEED_SIGNAL_BUS_PATH=/run/mdfeed/signals.sock
MDFEED_SQLITE_PATH=/var/lib/mdfeed/mdfeed.db

# 원시 체결·호가 보존 일수. 0 = 끄기(기본). 봉(bars_1m)과 품질 이벤트는
# 보존 대상이 아니라 지워지지 않는다 — 봉은 원시 데이터의 요약이라
# 지우면 과거를 복구할 수 없고, 크기도 체결의 1/100 수준이다.
# 실측(688종목): DB 증가 약 203MB/h = 하루 4.9GB · 한 달 146GB.
# 끄고 두면 디스크가 찰 때까지 쓰다가 죽는다. writer 가 남은 시간을
# disk_hours_until_full 로 내보내므로 그걸 보고 정할 것.
# MDFEED_RETENTION_DAYS=30
# MDFEED_RETENTION_INTERVAL_S=3600
# MDFEED_DISK_WARN_HOURS=24
MDFEED_LOG_LEVEL=INFO
MDFEED_LOG_JSON=1

# Postgres 를 쓰면 주석 해제 (없으면 SQLite 폴백)
# DATABASE_URL=postgresql://mdfeed:CHANGEME@127.0.0.1:5432/mdfeed

# KRX 는 REST 폴링이라 종목을 늘려도 데이터가 늘지 않는다. 한 바퀴 도는
# 시간만 길어진다 — 3 req/s 에 1,783종목이면 종목당 갱신 주기가 약 10분,
# 코스닥까지 켜면 20분이다. /healthz 의 lap_s 로 확인하고 정할 것.
# MDFEED_KRX_MARKETS=KOSPI,KOSDAQ
# MDFEED_KRX_UNIVERSE_LIMIT=0

# KIS REST 유량. AIMD 로 스스로 조절하되, 기본은 KIS_REST_RATE 를 천장으로
# 쓴다(그 위를 탐색하지 않는다). RATE_MAX 를 주면 거기까지 올라가며 실제
# 한도를 찾는다. 문서·실측 한도는 5 req/s.
#   3 req/s → 1,783종목 한 바퀴 594초 · 5 req/s → 357초
# /healthz 의 reject_pct 를 보고 정할 것. 높으면 슬롯을 버리는 것이고,
# 0 에 가까우면 여유를 안 쓰는 것이다(실측 2.7%).
# MDFEED_KIS_REST_RATE=3.0
# MDFEED_KIS_REST_RATE_MAX=5.0

# 한국투자증권 실시간 (없으면 KIS 어댑터가 자동 비활성화)
# KIS_APP_KEY=
# KIS_APP_SECRET=
